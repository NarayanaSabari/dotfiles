{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(kubectl get *)",
      "Bash(kubectl describe *)",
      "Bash(kubectl logs *)",
      "Bash(docker compose config *)",
      "Bash(no-mistakes status *)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "skillOverrides": {
    "handoff": "off",
    "receiving-review": "off"
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/sabari/.claude/hooks/notify.sh attention",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/sabari/.claude/hooks/git-identity-guard.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/Users/sabari/.claude/hooks/git-guardrails.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/Users/sabari/.claude/hooks/worktree-adopt-guard.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/sabari/.local/bin/jcode' setup-hotkey --notify-cli-launch claude",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/sabari/.claude/hooks/notify.sh done",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "/Users/sabari/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "claude-mem@thedotmack": true
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "api.anthropic.com",
        "api.openai.com"
      ]
    },
    "excludedCommands": [
      "codex"
    ]
  },
  "effortLevel": "medium",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "custom:brewer-dark",
  "preferredNotifChannel": "terminal_bell",
  "terminalProgressBarEnabled": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
