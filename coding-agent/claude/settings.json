      "Bash(uv run ruff*)",
      "Bash(uv run pyright*)",
      "Bash(uv run mypy*)",
      "Bash(uv sync*)",
      "Bash(uv lock*)",
      "Bash(npx tsc*)",
      "Bash(node --test*)",
      "Bash(npm test*)",
      "Bash(npm run lint*)",
      "Bash(npm run typecheck*)",
      "Bash(npm run build*)",
      "Bash(pnpm test*)",
      "Bash(pnpm lint*)",
      "Bash(pytest*)",
      "Bash(cargo build*)",
      "Bash(cargo test*)",
      "Bash(cargo clippy*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr diff*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(kubectl get *)",
      "Bash(kubectl describe *)",
      "Bash(kubectl logs *)",
      "Bash(docker compose config *)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(herdr status*)",
      "Bash(herdr agent list*)",
      "Bash(herdr agent get*)",
      "Bash(herdr agent read*)",
      "Bash(herdr agent explain*)",
      "Bash(herdr pane list*)",
      "Bash(herdr pane current*)",
      "Bash(herdr pane get*)",
