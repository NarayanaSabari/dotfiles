      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/.aws/credentials)",
      "Read(/Users/sabari/.ssh/**)",
      "Read(/Users/sabari/.claude/.credentials.json)",
      "Edit(**/.env)",
      "Edit(**/.env.*)"
