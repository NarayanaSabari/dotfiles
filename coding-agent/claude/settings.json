    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "skillOverrides": {
    "handoff": "off",
    "receiving-review": "off"
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/sabari/dotfiles/coding-agent/hooks/notify.sh attention",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/sabari/Library/Application Support/Xirp/xirp-external/hook-scripts/claude/notification.cjs'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/sabari/dotfiles/coding-agent/hooks/credential-guard.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/sabari/dotfiles/coding-agent/hooks/git-identity-guard.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/Users/sabari/dotfiles/coding-agent/hooks/git-guardrails.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/Users/sabari/dotfiles/coding-agent/hooks/commit-signature-guard.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/sabari/Library/Application Support/Xirp/xirp-external/hook-scripts/claude/preToolUse.cjs'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/sabari/.local/bin/jcode' setup-hotkey --notify-cli-launch claude",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/sabari/dotfiles/coding-agent/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/sabari/Library/Application Support/Xirp/xirp-external/hook-scripts/claude/sessionStart.cjs'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/sabari/dotfiles/coding-agent/hooks/notify.sh done",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/sabari/Library/Application Support/Xirp/xirp-external/hook-scripts/claude/stop.cjs'"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/sabari/Library/Application Support/Xirp/xirp-external/hook-scripts/claude/permissionRequest.cjs'"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "/Users/sabari/.claude/xirp-statusline-wrapper.sh"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "api.anthropic.com",
        "api.openai.com"
      ]
    }
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "custom:brewer-dark",
  "preferredNotifChannel": "terminal_bell",
  "terminalProgressBarEnabled": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
