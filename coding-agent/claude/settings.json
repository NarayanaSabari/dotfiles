    "deny": [
      "Bash(sudo *)",
      "Bash(doas *)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(curl * | zsh*)",
      "Bash(wget * | sh*)",
      "Bash(wget * | bash*)",
      "Bash(git push --force origin main*)",
      "Bash(git push --force origin master*)",
      "Bash(git push --force-with-lease origin main*)",
      "Bash(git push --force-with-lease origin master*)",
      "Bash(git push -f origin main*)",
      "Bash(git push -f origin master*)",
      "Bash(git push --force --all*)",
      "Bash(git push --mirror*)",
      "Bash(rm -rf /*)",
      "Bash(rm -fr /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $HOME*)",
      "Bash(rm -rf ..*)",
      "Bash(rm -rf /Users/sabari/.claude*)",
      "Bash(rm -rf /Users/sabari/dotfiles*)",
      "Bash(rm -rf /Users/sabari/Developer*)",
      "Bash(rm -rf /Users/sabari/.ssh*)",
      "Bash(terraform destroy*)",
      "Bash(terraform apply -auto-approve*)",
      "Bash(pulumi destroy*)",
      "Bash(kubectl delete *)",
      "Bash(helm delete *)",
      "Bash(helm uninstall *)",
      "Bash(aws * delete-*)",
