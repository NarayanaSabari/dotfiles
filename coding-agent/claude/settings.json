      "Bash(* DROP DATABASE *)",
      "Bash(* TRUNCATE *)",
      "Bash(*prisma migrate reset*)",
      "Bash(*prisma db push --accept-data-loss*)",
      "Bash(*alembic downgrade*)",
      "Bash(*flyctl * destroy*)",
      "Bash(npm publish*)",
      "Bash(chmod -R 777 *)",
